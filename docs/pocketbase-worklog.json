[
  {
    "name": "worklog",
    "type": "base",
    "listRule": "user = @request.auth.id",
    "viewRule": "user = @request.auth.id",
    "createRule": "@request.auth.id != \"\" && user = @request.auth.id",
    "updateRule": "user = @request.auth.id && (@request.body.user:isset = false || @request.body.user = @request.auth.id)",
    "deleteRule": null,
    "fields": [
      { "name": "user", "type": "relation", "required": true, "collectionId": "_pb_users_auth_", "cascadeDelete": true, "maxSelect": 1, "minSelect": 0 },
      { "name": "savedAt", "type": "number", "required": false },
      { "name": "data", "type": "json", "required": false, "maxSize": 20000000 }
    ],
    "indexes": ["CREATE UNIQUE INDEX idx_worklog_user ON worklog (user)"]
  }
]
